<view class="rights-screen page-screen">
  <view class="rights-hero">
    <text class="rights-hero__eyebrow">仅限当前本人会话</text>
    <text class="rights-hero__title">我的数据与隐私</text>
    <text class="rights-hero__body">查看茸光保存的资料、导出结构化副本，或在满足条件时匿名化删除。</text>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="state-card">正在核对本人数据边界…</view>

  <view wx:elif="{{pageState === 'auth'}}" class="state-card">
    <text class="state-card__title">需要演示顾客身份</text>
    <text class="state-card__body">{{errorMessage}}</text>
    <button class="primary-button" bindtap="chooseCustomer">选择演示顾客</button>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="state-card">
    <text class="state-card__title">暂时无法读取</text>
    <text class="state-card__body">{{errorMessage}}</text>
    <button class="secondary-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{pageState === 'ready'}}">
    <view class="identity-card surface-card">
      <view>
        <text class="identity-card__label">当前本人</text>
        <text class="identity-card__name">{{customerName}}</text>
      </view>
      <text class="identity-card__phone">{{phoneMasked}}</text>
    </view>

    <view class="section-heading">
      <text class="section-heading__title">当前保存的数据</text>
      <text class="section-heading__body">导出文件包含本人顾客资料、宠物、隐私同意、预约与模拟消息。</text>
    </view>
    <view class="summary-grid">
      <view class="summary-card"><text class="summary-card__value">{{summary.petCount}}</text><text>宠物档案</text></view>
      <view class="summary-card"><text class="summary-card__value">{{summary.privacyConsentCount}}</text><text>同意事实</text></view>
      <view class="summary-card"><text class="summary-card__value">{{summary.bookingCount}}</text><text>预约记录</text></view>
      <view class="summary-card"><text class="summary-card__value">{{summary.messageCount}}</text><text>模拟消息</text></view>
    </view>
    <button class="primary-button action-button" bindtap="exportData" loading="{{exporting}}" disabled="{{exporting}}">
      {{exporting ? '正在生成 JSON…' : '导出我的数据（JSON）'}}
    </button>

    <view wx:if="{{futureBookings.length}}" class="blocked-card">
      <text class="blocked-card__title">暂时不能删除</text>
      <text class="blocked-card__body">以下预约尚未结束。请先进入预约详情完成改期或取消，再返回此页。</text>
      <button
        wx:for="{{futureBookings}}"
        wx:key="id"
        class="booking-row"
        data-id="{{item.id}}"
        bindtap="openFutureBooking"
      >
        <view class="booking-row__copy">
          <text class="booking-row__title">{{item.petName}} · {{item.primaryServiceName}}</text>
          <text class="booking-row__meta">{{item.dateLabel}} {{item.timeLabel}}</text>
        </view>
        <text class="booking-row__action">查看 ›</text>
      </button>
    </view>

    <view class="retention-card surface-card">
      <text class="retention-card__title">删除后会发生什么</text>
      <text class="retention-card__heading">会匿名化</text>
      <view wx:for="{{anonymizedItems}}" wx:key="*this" class="fact-row"><text class="fact-row__dot">✓</text><text>{{item}}</text></view>
      <text class="retention-card__heading retention-card__heading--retained">仍会保留</text>
      <view wx:for="{{retainedItems}}" wx:key="*this" class="fact-row"><text class="fact-row__dot fact-row__dot--retained">•</text><text>{{item}}</text></view>
      <text class="disclaimer">{{disclaimer}}</text>
    </view>

    <view wx:if="{{errorMessage}}" class="error-note">{{errorMessage}}</view>
    <button class="danger-button action-button" bindtap="openDeletionConfirmation" disabled="{{!canDelete}}">
      {{canDelete ? '删除我的资料' : '请先处理未来预约'}}
    </button>
  </block>

  <view wx:elif="{{pageState === 'deleted'}}" class="state-card">
    <text class="state-card__title">资料已匿名化</text>
    <text class="state-card__body">当前会话已经失效，返回“我的”可重新选择其他演示顾客。</text>
  </view>

  <view wx:if="{{confirmationStep > 0}}" class="sheet-mask" bindtap="closeDeletionConfirmation">
    <view class="confirmation-sheet" catchtap="noop">
      <block wx:if="{{confirmationStep === 1}}">
        <text class="confirmation-sheet__step">第 1 步 / 共 2 步</text>
        <text class="confirmation-sheet__title">先确认影响范围</text>
        <text class="confirmation-sheet__body">姓名、手机号、宠物档案、照片、护理资料和身份关联将被匿名化，旧会话会立即失效。</text>
        <text class="confirmation-sheet__body">匿名预约历史、经营统计与删除审计仍会保留，不能由管理端重新拼回身份。</text>
        <button class="danger-button" bindtap="advanceDeletionConfirmation">我已理解，继续</button>
        <button class="sheet-cancel" bindtap="closeDeletionConfirmation">暂不删除</button>
      </block>
      <block wx:else>
        <text class="confirmation-sheet__step">第 2 步 / 共 2 步</text>
        <text class="confirmation-sheet__title">最终确认匿名化</text>
        <checkbox-group bindchange="updateDeletionAcknowledgement">
          <label class="confirmation-check">
            <checkbox value="confirmed" checked="{{deletionAcknowledged}}" color="#B65C4A" />
            <text>我确认删除身份和宠物资料，并理解匿名经营事实仍会保留。</text>
          </label>
        </checkbox-group>
        <button class="danger-button" bindtap="submitDeletion" loading="{{deleting}}" disabled="{{!deletionAcknowledged || deleting}}">
          确认删除并使会话失效
        </button>
        <button class="sheet-cancel" bindtap="closeDeletionConfirmation" disabled="{{deleting}}">返回检查</button>
      </block>
    </view>
  </view>
</view>
