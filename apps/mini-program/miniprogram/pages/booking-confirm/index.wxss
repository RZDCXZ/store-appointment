@import "../../styles/booking-flow.wxss";

.confirm-sheet {
  overflow: hidden;
  margin-top: 30rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 28rpx;
  background: #fffcf7;
}
.confirm-row {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  gap: 18rpx;
  align-items: center;
  min-height: 116rpx;
  padding: 22rpx 26rpx;
  border-bottom: 1rpx solid #ddd7cb;
}
.confirm-row:last-child {
  border-bottom: 0;
}
.confirm-row__label {
  color: #61706a;
  font-size: 26rpx;
}
.confirm-row > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}
.confirm-row__value {
  color: #24312c;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.5;
}
.confirm-row__detail {
  margin-top: 6rpx;
  color: #61706a;
  font-size: 23rpx;
  line-height: 1.5;
}
.confirm-row--price .confirm-row__value {
  color: #3f6253;
  font-size: 40rpx;
}
.consent-summary {
  display: flex;
  gap: 18rpx;
  align-items: center;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  color: #3f6253;
  background: #e4ece6;
}
.consent-summary__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #fff;
  background: #3f6253;
}
.consent-summary view {
  display: flex;
  flex-direction: column;
  font-size: 27rpx;
  font-weight: 700;
}
.consent-summary view text:last-child {
  margin-top: 4rpx;
  color: #61706a;
  font-size: 23rpx;
  font-weight: 400;
}
.submission-note {
  display: block;
  margin: 22rpx 6rpx 0;
  color: #61706a;
  font-size: 24rpx;
  line-height: 1.65;
}
.submission-error {
  display: flex;
  flex-direction: column;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  color: #7d4038;
  background: #f9e2dc;
  font-size: 26rpx;
  line-height: 1.55;
}
.submission-error button {
  min-height: 76rpx;
  margin-top: 14rpx;
  border: 0;
  color: #3f6253;
  background: #fffcf7;
  font-size: 26rpx;
  font-weight: 700;
}
