<view class="privacy-screen page-screen">
  <view class="page-heading">
    <view>
      <text class="page-heading__brand">茸光</text>
      <text class="page-heading__title">隐私同意</text>
      <text class="page-heading__subtitle">首次预约与说明更新后明确确认</text>
    </view>
    <text class="demo-mark">演示规则</text>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="privacy-loading surface-card">
    <view></view><view></view><view></view>
  </view>

  <view wx:elif="{{pageState === 'auth'}}" class="privacy-state surface-card">
    <text class="privacy-state__title">{{authState === 'expired' ? '演示会话已失效' : '请先选择演示顾客'}}</text>
    <text class="privacy-state__body">当前隐私同意页面会保留，重新选择后可继续。</text>
    <button class="primary-button" bindtap="chooseCustomer">选择演示顾客</button>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="privacy-state surface-card">
    <text class="privacy-state__title">隐私说明没有加载出来</text>
    <text class="privacy-state__body">{{errorMessage}}</text>
    <button class="secondary-button" bindtap="loadStatus">重新加载</button>
  </view>

  <view wx:elif="{{pageState === 'ready' && status}}">
    <view class="document-hero">
      <view class="document-hero__lock">锁</view>
      <text class="document-hero__title">
        {{status.requiresConsent ? '请确认当前隐私说明' : '当前版本已确认'}}
      </text>
      <text class="document-hero__body">我们只使用完成预约与宠物洗护所需的信息。</text>
    </view>

    <view class="notice-card surface-card">
      <view class="notice-row"><text>当前版本</text><text class="notice-row__value">{{status.notice.version}}</text></view>
      <view class="notice-row"><text>发布时间</text><text class="notice-row__value">{{status.notice.publishedAt}}</text></view>
      <view class="notice-row"><text>信息范围</text><text class="notice-row__value">顾客资料、宠物档案、预约记录</text></view>
      <view class="notice-row"><text>使用目的</text><text class="notice-row__value">预约匹配、洗护履约与历史关联</text></view>
      <view class="notice-row"><text>保留方式</text><text class="notice-row__value">删除请求后匿名保留必要历史事实</text></view>
      <text class="notice-summary">{{status.notice.summary}}</text>
    </view>

    <view wx:if="{{status.consent}}" class="consent-fact surface-card">
      <text class="consent-fact__badge">✓ 已留下可追踪事实</text>
      <view><text>同意版本</text><text>{{status.consent.version}}</text></view>
      <view><text>同意来源</text><text>{{status.consent.source === 'miniapp_booking' ? '小程序预约入口' : '店长线下确认'}}</text></view>
      <view><text>同意时间</text><text>{{status.consent.consentedAt}}</text></view>
    </view>

    <button
      wx:if="{{status.requiresConsent}}"
      class="consent-check {{accepted ? 'consent-check--accepted' : ''}}"
      bindtap="toggleAccepted"
      aria-role="checkbox"
      aria-checked="{{accepted}}"
    >
      <text class="consent-check__box">{{accepted ? '✓' : ''}}</text>
      <text>我已阅读并同意《{{status.notice.title}}》当前版本 {{status.notice.version}}</text>
    </button>

    <view wx:if="{{errorMessage}}" class="privacy-error" role="alert">{{errorMessage}}</view>

    <button
      class="privacy-submit"
      bindtap="confirmConsent"
      loading="{{submitting}}"
      disabled="{{submitting || (status.requiresConsent && !accepted)}}"
    >{{status.requiresConsent ? '同意并继续' : (returnTo ? '继续预约' : '完成')}}</button>

    <text class="privacy-footnote">隐私同意不是默认登录授权或营销订阅；版本更新后需要重新确认。</text>
  </view>
</view>
