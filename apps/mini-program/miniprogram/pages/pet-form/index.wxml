<view class="pet-form-screen page-screen">
  <view class="page-heading">
    <view>
      <text class="page-heading__brand">茸光</text>
      <text class="page-heading__title">{{isEditing ? '编辑宠物' : '新建宠物'}}</text>
      <text class="page-heading__subtitle">用于预约匹配与员工履约准备</text>
    </view>
    <text class="demo-mark">演示模式</text>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="form-loading surface-card">
    <view class="form-loading__line"></view><view class="form-loading__line form-loading__line--short"></view>
    <view class="form-loading__block"></view>
  </view>

  <view wx:elif="{{pageState === 'auth'}}" class="form-state surface-card">
    <text class="form-state__title">{{authState === 'expired' ? '演示会话已失效' : '请先选择演示顾客'}}</text>
    <text class="form-state__body">编辑页路径和宠物 ID 已保留，重新选择后可恢复。</text>
    <button class="primary-button" bindtap="chooseCustomer">选择演示顾客</button>
  </view>

  <view wx:elif="{{pageState === 'forbidden'}}" class="form-state form-state--danger surface-card">
    <text class="form-state__title">无法访问这份宠物档案</text>
    <text class="form-state__body">它不存在或不属于当前顾客，页面不会显示可绕过的编辑控件。</text>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="form-state surface-card">
    <text class="form-state__title">宠物档案没有加载出来</text>
    <text class="form-state__body">{{loadError}}</text>
    <button class="secondary-button" bindtap="retryLoad">重新加载</button>
  </view>

  <form wx:elif="{{pageState === 'ready'}}" bindsubmit="submit">
    <view wx:if="{{submitError}}" class="submit-error" role="alert">
      <text class="submit-error__title">没有保存</text>
      <text>{{submitError}} 表单内容仍在，可修改后重试。</text>
    </view>

    <view class="photo-card surface-card">
      <image class="photo-card__image" src="{{photoPreview || '/assets/brand/rongguang-hero-shiba.jpg'}}" mode="aspectFill" />
      <view class="photo-card__copy">
        <text class="photo-card__title">宠物照片</text>
        <text class="photo-card__body">JPEG / PNG，最大 512 KiB</text>
        <button class="photo-card__action" bindtap="choosePhoto" loading="{{uploadingPhoto}}" disabled="{{uploadingPhoto}}">选择照片</button>
      </view>
    </view>
    <view wx:if="{{photoError}}" class="photo-error" role="alert">
      <text>{{photoError}} 已保留表单和所选照片。</text>
      <button wx:if="{{pendingPhotoPath}}" bindtap="retryPhotoUpload">重试上传</button>
    </view>

    <view class="form-section surface-card">
      <view class="form-section__heading">
        <text class="form-section__index">01</text>
        <view><text class="form-section__title">基础资料</text><text class="form-section__hint">名称、犬猫和当前体重必填</text></view>
      </view>

      <label class="field {{fieldErrors.name ? 'field--error' : ''}}">
        <text class="field__label">宠物名称 *</text>
        <input value="{{form.name}}" maxlength="30" placeholder="例如：团子" data-field="name" bindinput="onTextInput" />
        <text wx:if="{{fieldErrors.name}}" class="field__error">{{fieldErrors.name}}</text>
      </label>

      <view class="field {{fieldErrors.species ? 'field--error' : ''}}">
        <text class="field__label">种类 *</text>
        <radio-group class="choice-row" bindchange="onSpeciesChange">
          <label class="choice-pill {{form.species === 'dog' ? 'choice-pill--selected' : ''}}"><radio value="dog" checked="{{form.species === 'dog'}}" />犬</label>
          <label class="choice-pill {{form.species === 'cat' ? 'choice-pill--selected' : ''}}"><radio value="cat" checked="{{form.species === 'cat'}}" />猫</label>
        </radio-group>
        <text wx:if="{{fieldErrors.species}}" class="field__error">{{fieldErrors.species}}</text>
      </view>

      <label class="field {{fieldErrors.weightKg ? 'field--error' : ''}}">
        <text class="field__label">当前体重（kg）*</text>
        <input type="digit" value="{{form.weightKg}}" maxlength="5" placeholder="例如：8.4" bindinput="onWeightInput" />
        <view wx:if="{{sizeSummary}}" class="size-summary">
          <text class="size-summary__value">{{sizeSummary}}</text>
          <text>体型会影响服务规格、价格与时长</text>
        </view>
        <text wx:if="{{fieldErrors.weightKg}}" class="field__error">{{fieldErrors.weightKg}}</text>
      </label>
    </view>

    <view class="form-section surface-card">
      <view class="form-section__heading">
        <text class="form-section__index">02</text>
        <view><text class="form-section__title">更多资料</text><text class="form-section__hint">均为选填</text></view>
      </view>

      <label class="field {{fieldErrors.breed ? 'field--error' : ''}}">
        <text class="field__label">品种</text>
        <input value="{{form.breed}}" maxlength="50" placeholder="例如：柴犬" data-field="breed" bindinput="onTextInput" />
        <text wx:if="{{fieldErrors.breed}}" class="field__error">{{fieldErrors.breed}}</text>
      </label>

      <view class="field {{fieldErrors.sex ? 'field--error' : ''}}">
        <text class="field__label">性别</text>
        <radio-group class="choice-row choice-row--compact" bindchange="onSexChange">
          <label class="choice-pill {{form.sex === '' ? 'choice-pill--selected' : ''}}"><radio value="" checked="{{form.sex === ''}}" />不填</label>
          <label class="choice-pill {{form.sex === 'male' ? 'choice-pill--selected' : ''}}"><radio value="male" checked="{{form.sex === 'male'}}" />公</label>
          <label class="choice-pill {{form.sex === 'female' ? 'choice-pill--selected' : ''}}"><radio value="female" checked="{{form.sex === 'female'}}" />母</label>
        </radio-group>
        <text wx:if="{{fieldErrors.sex}}" class="field__error">{{fieldErrors.sex}}</text>
      </view>

      <view class="field {{fieldErrors.birthDate ? 'field--error' : ''}}">
        <text class="field__label">出生日期</text>
        <view class="picker-row">
          <picker mode="date" value="{{form.birthDate}}" end="2026-08-13" bindchange="onBirthDateChange">
            <view class="picker-value">{{form.birthDate || '请选择（选填）'}} ›</view>
          </picker>
          <button wx:if="{{form.birthDate}}" class="clear-button" bindtap="clearBirthDate">清除</button>
        </view>
        <text wx:if="{{fieldErrors.birthDate}}" class="field__error">{{fieldErrors.birthDate}}</text>
      </view>

      <view class="field {{fieldErrors.coatType ? 'field--error' : ''}}">
        <text class="field__label">毛发类型</text>
        <picker range="{{coatTypeOptions}}" value="{{coatTypeIndex}}" bindchange="onCoatTypeChange">
          <view class="picker-value">{{coatTypeOptions[coatTypeIndex]}} ›</view>
        </picker>
        <text wx:if="{{fieldErrors.coatType}}" class="field__error">{{fieldErrors.coatType}}</text>
      </view>
    </view>

    <view class="form-section surface-card">
      <view class="form-section__heading">
        <text class="form-section__index">03</text>
        <view><text class="form-section__title">护理信息</text><text class="form-section__hint">帮助员工提前准备</text></view>
      </view>
      <view class="care-boundary">
        <text class="care-boundary__title">护理提示，不是医疗病历或诊断</text>
        <text>这里只记录洗护安全与偏好；宠物不适请联系专业兽医。</text>
      </view>
      <view class="field {{fieldErrors.careTags ? 'field--error' : ''}}">
        <text class="field__label">护理标签</text>
        <view class="tag-grid">
          <button
            wx:for="{{tagOptions}}"
            wx:key="label"
            class="tag-option {{item.selected ? 'tag-option--selected' : ''}}"
            data-tag="{{item.label}}"
            bindtap="toggleTag"
          >{{item.selected ? '✓ ' : ''}}{{item.label}}</button>
        </view>
        <text wx:if="{{fieldErrors.careTags}}" class="field__error">{{fieldErrors.careTags}}</text>
      </view>
      <label class="field {{fieldErrors.careNotes ? 'field--error' : ''}}">
        <text class="field__label">护理注意事项</text>
        <textarea value="{{form.careNotes}}" maxlength="500" auto-height placeholder="例如：吹风时先从低档开始" data-field="careNotes" bindinput="onTextInput"></textarea>
        <text class="field__count">{{form.careNotes.length}} / 500</text>
        <text wx:if="{{fieldErrors.careNotes}}" class="field__error">{{fieldErrors.careNotes}}</text>
      </label>
    </view>

    <button class="save-button" form-type="submit" loading="{{saving}}" disabled="{{saving || uploadingPhoto}}">
      {{saving ? '正在保存…' : '保存宠物档案'}}
    </button>

    <view wx:if="{{isEditing}}" class="danger-zone surface-card">
      <text class="danger-zone__title">{{isArchived ? '恢复宠物' : '归档宠物'}}</text>
      <text class="danger-zone__body">
        {{isArchived ? '恢复后可再次用于新预约。' : (futureBookingLabel || '没有未来预约时可归档，历史关联仍会保留。')}}
      </text>
      <button
        class="danger-zone__button {{isArchived ? 'danger-zone__button--restore' : ''}}"
        bindtap="archiveOrRestore"
        loading="{{archiving}}"
        disabled="{{archiving || (!isArchived && !!futureBookingLabel)}}"
      >{{isArchived ? '恢复使用' : '归档宠物'}}</button>
    </view>
  </form>
</view>
