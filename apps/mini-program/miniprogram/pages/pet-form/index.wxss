.pet-form-screen {
  padding-bottom: 88rpx;
}
.form-loading,
.form-state {
  margin-top: 28rpx;
  padding: 38rpx;
}
.form-loading__line {
  height: 34rpx;
  border-radius: 12rpx;
  background: #eee7da;
}
.form-loading__line--short {
  width: 54%;
  margin-top: 18rpx;
}
.form-loading__block {
  height: 280rpx;
  margin-top: 34rpx;
  border-radius: 22rpx;
  background: #f4ede2;
}
.form-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}
.form-state__title {
  font-size: 34rpx;
  font-weight: 700;
}
.form-state__body {
  margin-top: 12rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.65;
}
.form-state--danger {
  border-color: rgba(139, 76, 65, 0.3);
  background: #fff8f4;
}
.submit-error {
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  color: #8b4c41;
  background: #f9e2dc;
  font-size: 27rpx;
  line-height: 1.55;
}
.submit-error__title {
  font-weight: 700;
}
.photo-card {
  display: grid;
  grid-template-columns: 170rpx 1fr;
  gap: 24rpx;
  align-items: center;
  padding: 24rpx;
}
.photo-card__image {
  width: 170rpx;
  height: 170rpx;
  border-radius: 24rpx;
  background: #eee7da;
}
.photo-card__copy {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
}
.photo-card__title {
  font-size: 32rpx;
  font-weight: 700;
}
.photo-card__body {
  margin-top: 8rpx;
  color: #61706a;
  font-size: 25rpx;
}
.photo-card__action {
  min-height: 70rpx;
  margin: 18rpx 0 0;
  padding: 0 20rpx;
  border-radius: 16rpx;
  color: #3f6253;
  background: #e4ece6;
  font-size: 26rpx;
  line-height: 70rpx;
}
.photo-card__action::after,
.photo-error button::after,
.choice-pill radio,
.tag-option::after,
.clear-button::after,
.save-button::after,
.danger-zone__button::after {
  border: 0;
}
.photo-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  color: #8b4c41;
  background: #f9e2dc;
  font-size: 26rpx;
  line-height: 1.5;
}
.photo-error button {
  flex: none;
  min-height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  color: #8b4c41;
  background: transparent;
  font-size: 26rpx;
  line-height: 64rpx;
}
.form-section {
  margin-top: 24rpx;
  padding: 30rpx;
}
.form-section__heading {
  display: grid;
  grid-template-columns: 52rpx 1fr;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 12rpx;
}
.form-section__index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #3f6253;
  background: #e4ece6;
  font-size: 22rpx;
  font-weight: 700;
}
.form-section__heading view {
  display: flex;
  flex-direction: column;
}
.form-section__title {
  font-size: 32rpx;
  font-weight: 700;
}
.form-section__hint {
  margin-top: 3rpx;
  color: #61706a;
  font-size: 24rpx;
}
.field {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
}
.field__label {
  margin-bottom: 12rpx;
  color: #37453f;
  font-size: 27rpx;
  font-weight: 600;
}
.field input,
.field textarea,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d8d1c5;
  border-radius: 18rpx;
  color: #24312c;
  background: #fff;
  font-size: 29rpx;
}
.field textarea {
  min-height: 160rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.6;
}
.field--error input,
.field--error textarea,
.field--error .picker-value {
  border-color: #b45f53;
  background: #fffaf8;
}
.field__error {
  margin-top: 9rpx;
  color: #a14e45;
  font-size: 24rpx;
  line-height: 1.45;
}
.field__count {
  align-self: flex-end;
  margin-top: 8rpx;
  color: #8a857d;
  font-size: 23rpx;
}
.choice-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}
.choice-row--compact {
  grid-template-columns: repeat(3, 1fr);
}
.choice-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border: 1rpx solid #d8d1c5;
  border-radius: 18rpx;
  color: #61706a;
  background: #fff;
  font-size: 28rpx;
}
.choice-pill--selected {
  border-color: #3f6253;
  color: #3f6253;
  background: #e4ece6;
  font-weight: 600;
}
.choice-pill radio {
  width: 0;
  height: 0;
  opacity: 0;
}
.size-summary {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  color: #61706a;
  background: #eef3ee;
  font-size: 24rpx;
}
.size-summary__value {
  color: #3f6253;
  font-size: 30rpx;
  font-weight: 700;
}
.picker-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12rpx;
  align-items: center;
}
.picker-value {
  display: flex;
  align-items: center;
}
.clear-button {
  min-height: 80rpx;
  margin: 0;
  padding: 0 10rpx;
  color: #61706a;
  background: transparent;
  font-size: 25rpx;
  line-height: 80rpx;
}
.care-boundary {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  color: #61706a;
  background: #f8ead6;
  font-size: 25rpx;
  line-height: 1.55;
}
.care-boundary__title {
  color: #855c2a;
  font-weight: 700;
}
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag-option {
  min-height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d8d1c5;
  border-radius: 999rpx;
  color: #61706a;
  background: #fff;
  font-size: 25rpx;
  line-height: 68rpx;
}
.tag-option--selected {
  border-color: #c77d6d;
  color: #8b4c41;
  background: #f9e2dc;
}
.save-button {
  min-height: 100rpx;
  margin: 30rpx 0 0;
  border-radius: 22rpx;
  color: #fff;
  background: #3f6253;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 100rpx;
}
.save-button[disabled] {
  color: rgba(255, 255, 255, 0.75);
  background: #899b92;
}
.danger-zone {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  margin-top: 34rpx;
  padding: 28rpx;
  border-color: rgba(155, 77, 69, 0.25);
}
.danger-zone__title {
  color: #8b4c41;
  font-size: 30rpx;
  font-weight: 700;
}
.danger-zone__body {
  margin-top: 9rpx;
  color: #61706a;
  font-size: 26rpx;
  line-height: 1.55;
}
.danger-zone__button {
  min-height: 76rpx;
  margin: 20rpx 0 0;
  padding: 0 22rpx;
  border-radius: 16rpx;
  color: #8b4c41;
  background: #fff0eb;
  font-size: 27rpx;
  line-height: 76rpx;
}
.danger-zone__button--restore {
  color: #3f6253;
  background: #e4ece6;
}
.danger-zone__button[disabled] {
  color: #989087;
  background: #eeeae2;
}
