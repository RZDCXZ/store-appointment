.catalog-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 32rpx 64rpx;
  background: #f6f1e7;
}

.catalog-heading {
  display: flex;
  flex-direction: column;
}

.catalog-heading__eyebrow {
  color: #6f8f7e;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.catalog-heading__title {
  margin-top: 12rpx;
  color: #24312c;
  font-family: serif;
  font-size: 56rpx;
  font-weight: 700;
}

.catalog-heading__body {
  max-width: 620rpx;
  margin-top: 16rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.65;
}

.query-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(154, 93, 31, 0.3);
  border-radius: 20rpx;
  background: #fff8ee;
}

.query-banner__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.query-banner__title {
  color: #9a5d1f;
  font-size: 28rpx;
  font-weight: 700;
}

.query-banner__body {
  margin-top: 6rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.5;
}

.query-banner__action {
  flex: none;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #3f6253;
  font-size: 28rpx;
  line-height: 88rpx;
}

.query-banner__action::after {
  border: 0;
}

.catalog-loading,
.service-list,
.addon-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 22rpx;
}

.loading-card {
  display: flex;
  min-height: 360rpx;
  overflow: hidden;
  border: 1rpx solid #e4ddd2;
  border-radius: 28rpx;
  background: #fffcf7;
}

.loading-card__image {
  width: 220rpx;
  background: #e9e2d7;
}

.loading-card__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 24rpx;
  padding: 36rpx 28rpx;
}

.loading-card__line {
  height: 28rpx;
  border-radius: 999rpx;
  background: #ede7dc;
}

.loading-card__line--medium {
  width: 75%;
}

.loading-card__line--short {
  width: 55%;
}

.catalog-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 32rpx;
  padding: 52rpx 36rpx;
  text-align: center;
}

.catalog-state__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: #3f6253;
  background: #e4ece6;
  font-family: serif;
  font-size: 40rpx;
  font-weight: 700;
}

.catalog-state__title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.catalog-state__body {
  margin-top: 12rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.65;
}

.refreshing-note {
  margin-top: 24rpx;
  color: #6f8f7e;
  font-size: 28rpx;
  text-align: right;
}

.catalog-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 38rpx;
}

.catalog-section-heading__title {
  color: #24312c;
  font-size: 34rpx;
  font-weight: 700;
}

.catalog-section-heading__meta {
  color: #61706a;
  font-size: 28rpx;
}

.catalog-section-heading--addons {
  margin-top: 52rpx;
}

.service-card {
  display: flex;
  align-items: stretch;
  align-self: stretch;
  box-sizing: border-box;
  width: 100%;
  min-height: 390rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid #ddd7cb;
  border-radius: 28rpx;
  color: #24312c;
  background: #fffcf7;
  line-height: normal;
  text-align: left;
}

.service-card__image {
  flex: none;
  width: 224rpx;
  min-height: 390rpx;
}

.service-card__content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 28rpx 26rpx;
}

.service-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.service-card__species {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #3f6253;
  background: #e4ece6;
  font-size: 28rpx;
}

.service-card__link {
  color: #3f6253;
  font-size: 28rpx;
}

.service-card__title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.service-card__description,
.addon-card__description {
  margin-top: 10rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.5;
}

.spec-table {
  margin-top: 18rpx;
  border-top: 1rpx solid #e4ddd2;
}

.spec-table__row {
  display: grid;
  grid-template-columns: 0.8fr 1fr 1.2fr;
  gap: 8rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee8de;
  color: #61706a;
  font-size: 28rpx;
}

.spec-table__price {
  color: #3f6253;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.addon-card {
  padding: 28rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 24rpx;
  background: rgba(255, 252, 247, 0.8);
}

.addon-card__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.addon-card__heading-copy {
  display: flex;
  flex-direction: column;
}

.addon-card__name {
  font-size: 30rpx;
  font-weight: 700;
}

.addon-card__species {
  margin-top: 6rpx;
  color: #61706a;
  font-size: 28rpx;
}

.addon-card__count {
  color: #c95f50;
  font-size: 28rpx;
}

.addon-card__specs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
}

.addon-card__spec {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 10rpx;
  border-radius: 14rpx;
  background: #f6f1e7;
  color: #61706a;
  font-size: 28rpx;
}

.addon-card__spec-value {
  color: #24312c;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}

.catalog-note {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  color: #61706a;
  background: #e4ece6;
  font-size: 28rpx;
  line-height: 1.55;
}
