<view class="page-shell">
  <view class="hero">
    <image
      class="hero__image"
      src="/assets/brand/rongguang-hero-shiba.jpg"
      mode="aspectFill"
      aria-label="晨光中的柴犬"
    />
    <view class="hero__veil"></view>
    <view class="hero__content">
      <view class="wordmark">
        <text class="wordmark__title">茸光</text>
        <text class="wordmark__subtitle">— 宠物洗护 —</text>
      </view>
      <button class="hero__identity" bindtap="chooseCustomer">
        {{customer ? '演示顾客 · ' + customer.displayName : '选择演示顾客'}} ›
      </button>
      <view class="opening">
        <text>{{businessSummary.statusLabel}} · {{businessSummary.hoursLabel}}</text>
        <text class="opening__date">{{businessSummary.dateLabel}}</text>
        <text class="opening__demo-label">上海演示时间</text>
      </view>
      <button class="hero__cta" bindtap="primaryAction">
        <view class="hero__cta-copy">
          <text class="hero__cta-title">为宠物预约洗护</text>
          <text class="hero__cta-note">先查看服务 · 创建功能后续开放</text>
        </view>
        <text class="hero__cta-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="readiness-card recent-card">
    <view class="readiness-card__topline">
      <view class="recent-card__calendar">近</view>
      <view class="readiness-card__identity">
        <text>最近预约</text>
        <text class="readiness-card__story">{{recentAppointment.title}}</text>
      </view>
      <text class="readiness-card__status">{{recentAppointment.badge}}</text>
    </view>
    <text class="readiness-card__body">{{recentAppointment.body}}</text>
    <text wx:if="{{connectionMessage}}" class="readiness-card__warning">{{connectionMessage}} 已保留当前身份。</text>
    <view class="readiness-card__divider"></view>
    <view class="readiness-card__row">
      <text>{{customer ? customer.story : '本地演示身份未选择'}}</text>
      <button wx:if="{{customer}}" class="readiness-card__link" bindtap="goAppointments">预约记录 ›</button>
      <button wx:else class="readiness-card__link" bindtap="chooseCustomer">选择顾客 ›</button>
    </view>
  </view>

  <view wx:if="{{catalogError}}" class="home-query-error" role="alert">
    <view class="home-query-error__copy">
      <text class="home-query-error__title">服务更新失败</text>
      <text>{{catalogError}} 这不是“暂无服务”。</text>
    </view>
    <button class="home-query-error__action" bindtap="retryCatalog">重试</button>
  </view>

  <view class="services-preview">
    <view class="services-preview__heading">
      <view class="services-preview__heading-copy">
        <text class="services-preview__title">洗护服务</text>
        <text class="services-preview__subtitle">犬猫与三种体型都有确定价格</text>
      </view>
      <button class="services-preview__more" bindtap="goServiceCatalog">全部服务 ›</button>
    </view>

    <view wx:if="{{catalogState === 'ready'}}" class="service-grid">
      <button
        class="service-preview-card"
        wx:for="{{serviceCards}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goServiceDetail"
      >
        <image class="service-preview-card__image" src="{{item.imagePath}}" mode="aspectFill" />
        <view class="service-preview-card__copy">
          <text class="service-preview-card__species">{{item.speciesLabel}}</text>
          <text class="service-preview-card__name">{{item.name}}</text>
          <text class="service-preview-card__fact">
            {{item.specifications[0].petSizeLabel}} {{item.specifications[0].priceLabel}} · {{item.specifications[0].durationLabel}}
          </text>
        </view>
      </button>
    </view>

    <view wx:elif="{{catalogState === 'loading'}}" class="home-service-state">
      <view class="home-service-skeleton" wx:for="{{[1, 2]}}" wx:key="*this"></view>
    </view>

    <view wx:elif="{{catalogState === 'empty'}}" class="home-service-empty">
      <text class="home-service-empty__title">当前没有可浏览的主要服务</text>
      <text class="home-service-empty__body">目录为空时不会展示虚构价格。</text>
      <button class="home-service-empty__action" bindtap="retryCatalog">刷新目录</button>
    </view>

    <view wx:else class="home-service-empty home-service-empty--error">
      <text class="home-service-empty__title">服务暂时没有加载出来</text>
      <text class="home-service-empty__body">{{catalogError}}</text>
      <button class="home-service-empty__action" bindtap="retryCatalog">重新加载</button>
    </view>
    <text wx:if="{{refreshingCatalog}}" class="services-preview__refreshing">正在更新服务…</text>
  </view>

  <view class="store-facts">
    <view class="store-facts__row">
      <text class="store-facts__label">茸光上海门店</text>
      <text>{{storeAddress}}</text>
    </view>
    <view class="store-facts__row">
      <text class="store-facts__label">联系方式</text>
      <text>{{contactPhone}}</text>
    </view>
    <text class="store-facts__note">即使今日闭店，也可以继续浏览服务并为未来日期做准备。</text>
  </view>

  <view class="service-promises">
    <text class="service-promises__title">安心预约洗护</text>
    <view class="service-promises__list">
      <view class="service-promises__item">
        <image class="service-promises__icon" src="/assets/promises/employee.png" mode="aspectFit" />
        <text>确定员工</text>
      </view>
      <view class="service-promises__item">
        <image class="service-promises__icon" src="/assets/promises/price.png" mode="aspectFit" />
        <text>价格透明</text>
      </view>
      <view class="service-promises__item service-promises__item--last">
        <image class="service-promises__icon" src="/assets/promises/checkin.png" mode="aspectFit" />
        <text>到店核销</text>
      </view>
    </view>
  </view>

  <view class="local-boundary">
    <text class="local-boundary__label">本地演示</text>
    <text>顾客身份由本地 API 临时签发，不是微信真实登录。</text>
  </view>
</view>
