.page-shell {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f6f1e7;
}

.hero {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: #e9dfcf;
}

.hero__image,
.hero__veil,
.hero__content {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero__image {
  display: block;
}

.hero__veil {
  background: linear-gradient(
    180deg,
    rgba(250, 244, 232, 0.88) 0%,
    rgba(250, 244, 232, 0.15) 48%,
    rgba(246, 241, 231, 0.92) 100%
  );
}

.hero__content {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 64rpx 40rpx 88rpx;
}

.wordmark {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  color: #3f6253;
}

.hero__identity {
  position: absolute;
  top: 58rpx;
  right: 32rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #24312c;
  background: rgba(255, 252, 247, 0.78);
  font-size: 28rpx;
  line-height: 88rpx;
}

.hero__identity::after {
  border: 0;
}

.hero__cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 390rpx;
  min-height: 108rpx;
  margin: 0;
  padding: 0 34rpx;
  border-radius: 24rpx;
  color: #fff;
  background: #3f6253;
  font-size: 30rpx;
  font-weight: 600;
}

.hero__cta::after {
  border: 0;
}

.hero__cta[disabled] {
  color: rgba(255, 255, 255, 0.8);
  background: #6f8f7e;
}

.hero__cta-arrow {
  font-size: 48rpx;
  font-weight: 300;
}

.hero__cta-copy {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
}

.hero__cta-title {
  font-size: 30rpx;
  font-weight: 600;
}

.hero__cta .hero__cta-note {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  font-weight: 400;
}

.wordmark__title {
  font-family: serif;
  font-size: 92rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  line-height: 1;
}

.wordmark__subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  letter-spacing: 8rpx;
}

.opening {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  color: #3f6253;
  font-size: 30rpx;
  line-height: 1.5;
}

.opening__date {
  margin-top: 12rpx;
  color: #24312c;
  font-size: 38rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.opening__demo-label {
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(63, 98, 83, 0.32);
  border-radius: 999rpx;
  color: #3f6253;
  background: rgba(255, 252, 247, 0.82);
  font-size: 28rpx;
  line-height: 1.4;
}

.readiness-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  margin: -54rpx 32rpx 0;
  padding: 34rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 28rpx;
  background: rgba(255, 252, 247, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(63, 98, 83, 0.1);
}

.readiness-card__topline {
  display: flex;
  align-items: center;
  color: #24312c;
  font-size: 32rpx;
  font-weight: 600;
}

.readiness-card__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #3f6253;
  color: #fff;
  font-family: serif;
}

.readiness-card__identity {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
}

.readiness-card__story {
  margin-top: 5rpx;
  color: #61706a;
  font-size: 28rpx;
  font-weight: 400;
}

.readiness-card__status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #3f6253;
  background: #e4ece6;
  font-size: 28rpx;
}

.readiness-card--auth {
  padding: 34rpx;
}

.readiness-card__auth-title {
  font-size: 34rpx;
  font-weight: 700;
}

.readiness-card__warning {
  display: block;
  margin-top: 16rpx;
  color: #9a5d1f;
  font-size: 28rpx;
  line-height: 1.55;
}

.readiness-card__body {
  display: block;
  margin-top: 22rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.75;
}

.readiness-card__divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: #ddd7cb;
}

.readiness-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #61706a;
  font-size: 28rpx;
}

.readiness-card__code {
  color: #3f6253;
  font-family: monospace;
  font-size: 28rpx;
  overflow-wrap: anywhere;
  text-align: right;
}

.readiness-card__link {
  min-height: 88rpx;
  margin: -24rpx 0;
  padding: 0;
  color: #3f6253;
  background: transparent;
  font-size: 28rpx;
  line-height: 88rpx;
}

.readiness-card__link::after {
  border: 0;
}

.service-promises {
  margin: 32rpx 32rpx 0;
}

.service-promises__title {
  font-size: 34rpx;
  font-weight: 700;
}

.service-promises__list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 20rpx;
  padding: 28rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 252, 247, 0.72);
}

.service-promises__item {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 12rpx;
  border-right: 1rpx solid #ddd7cb;
  font-size: 28rpx;
}

.service-promises__item--last {
  border-right: 0;
}

.service-promises__icon {
  display: block;
  width: 56rpx;
  height: 56rpx;
}

.local-boundary {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  margin: 28rpx 32rpx 0;
  padding: 28rpx 30rpx;
  border-radius: 22rpx;
  color: #61706a;
  background: #f9e2dc;
  font-size: 28rpx;
  line-height: 1.65;
}

.local-boundary__label {
  margin-bottom: 8rpx;
  color: #a84444;
  font-weight: 600;
}

.local-boundary__code {
  margin-top: 8rpx;
  color: #24312c;
  font-family: monospace;
}

.recent-card__calendar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #3f6253;
  font-family: serif;
  font-size: 26rpx;
}

.home-query-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 28rpx 32rpx 0;
  padding: 24rpx;
  border: 1rpx solid rgba(154, 93, 31, 0.3);
  border-radius: 20rpx;
  background: #fff8ee;
}

.home-query-error__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.5;
}

.home-query-error__title {
  color: #9a5d1f;
  font-size: 28rpx;
  font-weight: 700;
}

.home-query-error__action,
.home-service-empty__action {
  min-height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #3f6253;
  font-size: 28rpx;
  line-height: 88rpx;
}

.home-query-error__action::after,
.home-service-empty__action::after,
.services-preview__more::after,
.service-preview-card::after {
  border: 0;
}

.services-preview {
  margin-top: 42rpx;
}

.services-preview__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 32rpx;
}

.services-preview__heading-copy {
  display: flex;
  flex-direction: column;
}

.services-preview__title {
  color: #24312c;
  font-size: 36rpx;
  font-weight: 700;
}

.services-preview__subtitle {
  margin-top: 7rpx;
  color: #61706a;
  font-size: 28rpx;
}

.services-preview__more {
  min-height: 88rpx;
  margin: -18rpx 0;
  padding: 0;
  color: #3f6253;
  background: transparent;
  font-size: 28rpx;
  line-height: 88rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 0 32rpx;
}

.service-preview-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 174rpx;
  margin: 0;
  padding: 20rpx;
  border: 0;
  border-radius: 24rpx;
  color: #24312c;
  background: rgba(255, 252, 247, 0.78);
  line-height: normal;
  text-align: left;
}

.service-preview-card__image {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}

.service-preview-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.service-preview-card__species {
  align-self: flex-start;
  color: #3f6253;
  font-size: 24rpx;
}

.service-preview-card__name {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.service-preview-card__fact {
  margin-top: 8rpx;
  color: #3f6253;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.5;
}

.home-service-state {
  display: flex;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 0 32rpx;
  overflow: hidden;
}

.home-service-skeleton {
  flex: none;
  width: 540rpx;
  height: 310rpx;
  border: 1rpx solid #e2dbcf;
  border-radius: 26rpx;
  background: linear-gradient(110deg, #e7e0d4 8%, #f0eade 18%, #e7e0d4 33%);
}

.home-service-empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 22rpx 32rpx 0;
  padding: 34rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 24rpx;
  background: #fffcf7;
  text-align: center;
}

.home-service-empty__title {
  font-size: 29rpx;
  font-weight: 700;
}

.home-service-empty__body {
  margin-top: 10rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.55;
}

.home-service-empty__action {
  margin-top: 22rpx;
}

.home-service-empty--error {
  border-color: rgba(154, 93, 31, 0.25);
}

.services-preview__refreshing {
  display: block;
  margin: 14rpx 32rpx 0;
  color: #6f8f7e;
  font-size: 24rpx;
  text-align: right;
}

.store-facts {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 38rpx 32rpx 0;
  padding: 30rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 24rpx;
  background: rgba(255, 252, 247, 0.76);
}

.store-facts__row {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 16rpx;
  color: #24312c;
  font-size: 28rpx;
  line-height: 1.5;
}

.store-facts__label {
  color: #3f6253;
  font-weight: 600;
}

.store-facts__note {
  padding-top: 18rpx;
  border-top: 1rpx solid #ddd7cb;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.55;
}
