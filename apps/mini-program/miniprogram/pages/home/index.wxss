.page-shell {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f6f1e7;
}

.hero {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: #e9dfcf;
}

.hero__image,
.hero__veil,
.hero__content {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero__image {
  display: block;
}

.hero__veil {
  background: linear-gradient(
    180deg,
    rgba(250, 244, 232, 0.88) 0%,
    rgba(250, 244, 232, 0.15) 48%,
    rgba(246, 241, 231, 0.92) 100%
  );
}

.hero__content {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 64rpx 40rpx 88rpx;
}

.wordmark {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  color: #3f6253;
}

.wordmark__title {
  font-family: serif;
  font-size: 92rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  line-height: 1;
}

.wordmark__subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  letter-spacing: 8rpx;
}

.opening {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  color: #3f6253;
  font-size: 30rpx;
  line-height: 1.5;
}

.opening__date {
  margin-top: 12rpx;
  color: #24312c;
  font-size: 38rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.opening__demo-label {
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(63, 98, 83, 0.32);
  border-radius: 999rpx;
  color: #3f6253;
  background: rgba(255, 252, 247, 0.82);
  font-size: 28rpx;
  line-height: 1.4;
}

.readiness-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  margin: -54rpx 32rpx 0;
  padding: 34rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 28rpx;
  background: rgba(255, 252, 247, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(63, 98, 83, 0.1);
}

.readiness-card__topline {
  display: flex;
  align-items: center;
  color: #24312c;
  font-size: 32rpx;
  font-weight: 600;
}

.readiness-card__dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 18rpx;
  border: 6rpx solid #e4ece6;
  border-radius: 50%;
  background: #3f6253;
}

.readiness-card__body {
  display: block;
  margin-top: 22rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.75;
}

.readiness-card__divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: #ddd7cb;
}

.readiness-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #61706a;
  font-size: 28rpx;
}

.readiness-card__code {
  color: #3f6253;
  font-family: monospace;
  font-size: 28rpx;
  overflow-wrap: anywhere;
  text-align: right;
}

.local-boundary {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  margin: 28rpx 32rpx 0;
  padding: 28rpx 30rpx;
  border-radius: 22rpx;
  color: #61706a;
  background: #f9e2dc;
  font-size: 28rpx;
  line-height: 1.65;
}

.local-boundary__label {
  margin-bottom: 8rpx;
  color: #a84444;
  font-weight: 600;
}

.local-boundary__code {
  margin-top: 8rpx;
  color: #24312c;
  font-family: monospace;
}
