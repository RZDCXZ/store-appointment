.detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 64rpx;
  background: #f6f1e7;
}

.detail-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(154, 93, 31, 0.3);
  border-radius: 20rpx;
  background: #fff8ee;
}

.detail-error view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  color: #61706a;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-error view text:first-child {
  color: #9a5d1f;
  font-size: 27rpx;
  font-weight: 700;
}

.detail-error button {
  min-height: 70rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #3f6253;
  font-size: 25rpx;
  line-height: 70rpx;
}

.detail-error button::after,
.detail-primary::after {
  border: 0;
}

.detail-loading {
  margin: 32rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #fffcf7;
}

.detail-loading__image {
  height: 470rpx;
  background: #e8e1d5;
}

.detail-loading__body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 38rpx;
}

.detail-loading__body view {
  height: 30rpx;
  border-radius: 999rpx;
  background: #eee7dc;
}

.detail-loading__body view:nth-child(2) {
  width: 80%;
}

.detail-loading__body view:nth-child(3) {
  width: 62%;
}

.detail-loading__body view:nth-child(4) {
  width: 72%;
}

.detail-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 36rpx 32rpx;
  padding: 56rpx 36rpx;
  text-align: center;
}

.detail-state__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  color: #3f6253;
  background: #e4ece6;
  font-family: serif;
  font-size: 40rpx;
  font-weight: 700;
}

.detail-state__title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.detail-state__body {
  margin-top: 12rpx;
  color: #61706a;
  font-size: 28rpx;
  line-height: 1.65;
}

.detail-refreshing {
  padding: 18rpx 32rpx;
  color: #6f8f7e;
  font-size: 24rpx;
  text-align: right;
}

.detail-hero {
  position: relative;
  height: 610rpx;
  overflow: hidden;
  background: #e9dfcf;
}

.detail-hero__image,
.detail-hero__veil,
.detail-hero__content {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-hero__veil {
  background: linear-gradient(180deg, rgba(36, 49, 44, 0.04) 25%, rgba(36, 49, 44, 0.82) 100%);
}

.detail-hero__content {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
  padding: 44rpx 36rpx;
  color: #fff;
}

.detail-hero__species {
  padding: 7rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  background: rgba(36, 49, 44, 0.25);
  font-size: 24rpx;
}

.detail-hero__title {
  margin-top: 16rpx;
  font-family: serif;
  font-size: 54rpx;
  font-weight: 700;
}

.detail-hero__body {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.detail-section {
  margin: 44rpx 32rpx 0;
}

.detail-section__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.detail-section__heading text:first-child {
  color: #24312c;
  font-size: 34rpx;
  font-weight: 700;
}

.detail-section__heading text:last-child {
  color: #61706a;
  font-size: 23rpx;
  text-align: right;
}

.detail-specs,
.detail-addons {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.detail-spec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 22rpx;
  background: #fffcf7;
}

.detail-spec__size,
.detail-spec__facts {
  display: flex;
  flex-direction: column;
}

.detail-spec__size text:first-child {
  font-size: 30rpx;
  font-weight: 700;
}

.detail-spec__size text:last-child {
  margin-top: 6rpx;
  color: #61706a;
  font-size: 23rpx;
}

.detail-spec__facts {
  align-items: flex-end;
  flex: none;
}

.detail-spec__facts text:first-child {
  color: #3f6253;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.detail-spec__facts text:last-child {
  margin-top: 6rpx;
  color: #61706a;
  font-size: 24rpx;
}

.detail-addon {
  padding: 28rpx;
  border: 1rpx solid #ddd7cb;
  border-radius: 22rpx;
  background: rgba(255, 252, 247, 0.82);
}

.detail-addon__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.detail-addon__heading view {
  display: flex;
  flex-direction: column;
}

.detail-addon__heading view text:first-child {
  font-size: 30rpx;
  font-weight: 700;
}

.detail-addon__heading view text:last-child {
  margin-top: 5rpx;
  color: #61706a;
  font-size: 23rpx;
}

.detail-addon__heading > text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #c95f50;
  background: #f9e2dc;
  font-size: 22rpx;
}

.detail-addon__body {
  display: block;
  margin-top: 14rpx;
  color: #61706a;
  font-size: 25rpx;
  line-height: 1.55;
}

.detail-addon__spec {
  display: grid;
  grid-template-columns: 0.8fr 2fr;
  gap: 14rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #e4ddd2;
  color: #61706a;
  font-size: 24rpx;
}

.detail-addon__spec text:last-child {
  color: #24312c;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.detail-addons-empty {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  color: #61706a;
  background: #fffcf7;
  font-size: 26rpx;
}

.detail-promise {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 44rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #e4ece6;
}

.detail-promise text:first-child {
  color: #3f6253;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-promise text:last-child {
  color: #61706a;
  font-size: 25rpx;
  line-height: 1.6;
}

.detail-primary {
  min-height: 96rpx;
  margin: 34rpx 32rpx 0;
  border-radius: 22rpx;
  color: #fff;
  background: #3f6253;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 96rpx;
}
