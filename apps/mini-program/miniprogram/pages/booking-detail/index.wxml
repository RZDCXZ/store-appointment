<view class="detail-page">
  <view wx:if="{{pageState === 'loading'}}" class="detail-state">
    <text class="detail-state__mark">茸</text>
    <text class="detail-state__title">正在读取当前预约</text>
    <text class="detail-state__body">状态变化后会重新拉取最新事实。</text>
  </view>

  <view wx:elif="{{pageState === 'auth'}}" class="detail-state">
    <text class="detail-state__mark">顾</text>
    <text class="detail-state__title">请重新选择演示顾客</text>
    <text class="detail-state__body">恢复身份后会返回这笔预约。</text>
    <button class="primary-button" bindtap="chooseCustomer">选择演示顾客</button>
  </view>

  <view wx:elif="{{pageState === 'missing'}}" class="detail-state">
    <text class="detail-state__mark">!</text>
    <text class="detail-state__title">缺少预约身份</text>
    <text class="detail-state__body">请从预约记录重新打开。</text>
    <button class="primary-button" bindtap="viewAppointments">查看预约记录</button>
  </view>

  <view wx:elif="{{pageState === 'forbidden'}}" class="detail-state detail-state--danger">
    <text class="detail-state__mark">!</text>
    <text class="detail-state__title">无法查看这笔预约</text>
    <text class="detail-state__body">记录不存在，或不属于当前顾客。替换预约标识不能访问其他顾客资料。</text>
    <button class="primary-button" bindtap="viewAppointments">返回我的预约</button>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="detail-state">
    <text class="detail-state__mark">!</text>
    <text class="detail-state__title">预约详情没有加载出来</text>
    <text class="detail-state__body">{{errorMessage}}</text>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view class="detail-status">
      <text class="status-tag status-tag--{{statusTone}}">{{statusLabel}}</text>
      <text class="detail-status__title">{{statusTitle}}</text>
      <text class="detail-status__body">{{nextStep}}</text>
    </view>

    <view wx:if="{{refreshing || errorMessage}}" class="refresh-band {{errorMessage ? 'refresh-band--error' : ''}}">
      <text>{{errorMessage ? '更新失败，当前仍显示上次取得的事实。' : '正在获取最新状态…'}}</text>
      <button wx:if="{{errorMessage}}" class="refresh-band__retry" bindtap="retry">重试</button>
    </view>

    <view wx:if="{{verificationCode}}" class="verification-card">
      <text class="verification-card__label">六位核销码</text>
      <text class="verification-card__code" aria-label="核销码 {{verificationCode}}">{{verificationCode}}</text>
      <text class="verification-card__window">{{verificationWindowLabel}}</text>
      <text class="verification-card__description">{{verificationWindowDescription}}</text>
    </view>

    <view class="detail-sheet">
      <view class="detail-row">
        <text class="detail-row__label">宠物</text>
        <text class="detail-row__value">{{petLabel}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-row__label">服务</text>
        <view class="detail-row__content">
          <text class="detail-row__value">{{serviceLabel}}</text>
          <text class="detail-row__hint">价格快照 {{priceLabel}} · {{durationLabel}}</text>
        </view>
      </view>
      <view class="detail-row">
        <text class="detail-row__label">员工</text>
        <text class="detail-row__value">{{staffLabel}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-row__label">计划时间</text>
        <view class="detail-row__content">
          <text class="detail-row__value">{{dateLabel}}</text>
          <text class="detail-row__hint detail-row__time">{{timeLabel}}</text>
        </view>
      </view>
      <view wx:if="{{completedAtLabel}}" class="detail-row detail-row--completed">
        <text class="detail-row__label">实际完成</text>
        <text class="detail-row__value">{{completedAtLabel}}</text>
      </view>
    </view>

    <view wx:if="{{canChange}}" class="change-actions">
      <button class="primary-button" bindtap="openReschedule">改期</button>
      <button class="change-actions__cancel" bindtap="openCancel">取消预约</button>
      <text class="change-actions__hint">{{changeMessage}}</text>
    </view>
    <view wx:elif="{{changeMessage && statusLabel === '已确认'}}" class="contact-band">
      <text class="contact-band__title">请联系门店处理</text>
      <text class="contact-band__body">{{changeMessage}}</text>
    </view>

    <view class="privacy-note">仅展示本次预约快照；不包含门店服务记录、员工内部说明或其他宠物资料。</view>
  </block>
</view>
