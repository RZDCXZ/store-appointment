{
  "name": "rongguang-store-appointment",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:migrate": "corepack pnpm --filter @rongguang/api db:migrate",
    "db:reset": "corepack pnpm --filter @rongguang/api db:reset",
    "db:seed": "corepack pnpm --filter @rongguang/api db:seed",
    "demo:up": "node scripts/demo-up.mjs",
    "dev": "turbo dev",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint scripts eslint.config.mjs --max-warnings=0 && turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.0.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
