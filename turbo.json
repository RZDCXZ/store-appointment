{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "ADMIN_ORIGIN",
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "DEMO_NOW",
        "VITE_API_BASE_URL",
        "VITE_DEMO_NOW"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@rongguang/mini-program#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
